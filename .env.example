# ==============================================================================
# BridgeAI Environment Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# 1. NEVER commit your actual `.env` or `.env.local` file to version control.
# 2. NEVER prefix backend secrets with NEXT_PUBLIC_.
# 3. GEMINI_API_KEY MUST remain server-side only to protect your quota & billing.
#
# To get started:
# cp .env.example .env.local
# Then fill in your Gemini API key from Google AI Studio (https://aistudio.google.com).
# ==============================================================================

# Google Gemini API Key (Required for server-side AI processing)
# NEVER expose this to the browser/client-side.
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model Selection (Optional, defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL="gemini-3.8-flash"

# Node Environment
NODE_ENV="development"

# Application Base URL (Optional, used for canonical URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
